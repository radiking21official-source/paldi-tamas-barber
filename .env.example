# ========= Páldi Tamás Barber — Environment variables =========

# Site URL (prod)
NEXT_PUBLIC_SITE_URL=https://www.paldi-tamas-barber.hu

# ========= Booking (Cal.com / Reservio / Fresha) =========
# Válassz: cal | reservio | fresha
NEXT_PUBLIC_BOOKING_PROVIDER=cal

# Cal.com (ha provider=cal)
NEXT_PUBLIC_CAL_USERNAME=paldi-tamas
NEXT_PUBLIC_CAL_EVENT_SLUG=

# Reservio (ha provider=reservio)
NEXT_PUBLIC_RESERVIO_USERNAME=

# Fresha (ha provider=fresha)
NEXT_PUBLIC_FRESHA_SLUG=

# ========= Resend (contact form opcionális) =========
RESEND_API_KEY=re_xxx
CONTACT_TO=info@paldi-tamas-barber.hu
CONTACT_FROM=noreply@paldi-tamas-barber.hu

# ========= Social =========
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/paldi_tamas_barber
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/paldi.tamas.barber

# ========= Analytics (opcionális) =========
NEXT_PUBLIC_GA_ID=
